# Copy to .streamlit/secrets.toml (git-ignored) to connect the app to a local Neo4j.
# Without these settings the app runs in demo mode on the bundled SQLite database.
NEO4J_URI = "bolt://localhost:7687"
NEO4J_USER = "neo4j"
NEO4J_PASSWORD = "your-password-here"
# KB_BACKEND = "sqlite"   # uncomment to force demo mode even when Neo4j is available
